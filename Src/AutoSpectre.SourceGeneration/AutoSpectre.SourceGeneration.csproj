<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>11</LangVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <IsRoslynComponent>true</IsRoslynComponent>    
    <PackageReleaseNotes>
      * Added cancellation-aware `PromptAsync(form, CancellationToken)` factories via `ICancellableSpectreFactory&lt;T&gt;`. Synchronous forms keep `Prompt` and now also implement `IAsyncSpectreFactory&lt;T&gt;` with both async overloads. Tokens flow through all prompt types, nested forms, collection confirmations and supported task-step parameters, with cancellation checks between steps. Existing async overloads, interface implementations and `AsyncSpectreFactoryBase&lt;T&gt;` subclasses remain compatible.
      * Task steps now accept a `CancellationToken`, alone or alongside `IAnsiConsole` in either parameter order. Synchronous calls inject `CancellationToken.None`.
      * Added a `net11.0` target alongside `net8.0` and `net10.0`. Building the package now requires .NET SDK 11 or later.
    </PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    
    <IncludeBuildOutput>false</IncludeBuildOutput> <!-- Do not include the generator as a lib dependency -->
    <Title>AutoSpectre Source Generation</Title>
    <PackageIcon>ghost.png</PackageIcon>  
    <Description>A tool to generate a form using Spectre.Console through a source generator that generate a new class to collect data. NOTE. This will be deprecated as it will be included into AutoSpectre nuget library directly</Description>
    <PackageProjectUrl>https://github.com/jeppevammenkristensen/auto-spectre</PackageProjectUrl>
    <PackageTags>C#;Source Generator</PackageTags>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Package the generator in the analyzer directory of the nuget package -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <InternalsVisibleTo Include="AutoSpectre.SourceGeneration.Tests" />
    <None Include="docs\Readme.md" Pack="true" PackagePath="\">      
    </None>
    <None Include="images\ghost.png" Pack="true" PackagePath="\">
    </None>
  </ItemGroup>

  <ItemGroup>    
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"
                      VersionOverride="$(AutoSpectreRoslynVersion)"
                      PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>


</Project>
