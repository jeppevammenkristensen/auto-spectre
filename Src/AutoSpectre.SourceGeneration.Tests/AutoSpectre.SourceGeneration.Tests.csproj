<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoSpectre.SourceGeneration\AutoSpectre.SourceGeneration.csproj" />
    <ProjectReference Include="..\AutoSpectre\AutoSpectre.csproj" />
  </ItemGroup>

  <!-- Inspect the packaged variants, not the generator selected for the test host. -->
  <ItemGroup>
    <EmbeddedResource Include="..\AutoSpectre.SourceGeneration\bin\$(Configuration)\roslyn4.8\AutoSpectre.SourceGeneration.dll"
                      LogicalName="Generator.roslyn4.8.dll" />
    <EmbeddedResource Include="..\AutoSpectre.SourceGeneration\bin\$(Configuration)\roslyn4.14\AutoSpectre.SourceGeneration.dll"
                      LogicalName="Generator.roslyn4.14.dll" />
    <EmbeddedResource Include="..\AutoSpectre.SourceGeneration\bin\$(Configuration)\roslyn5.3\AutoSpectre.SourceGeneration.dll"
                      LogicalName="Generator.roslyn5.3.dll" />
  </ItemGroup>

</Project>
