<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Description>Classes used by the AutoSpectre.SourceGeneration package</Description>
    <PackageReleaseNotes>
      - Bumped Spectre version to 0.57.2      
    </PackageReleaseNotes>
    <PackageIcon>ghost.png</PackageIcon>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  
<!--  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">-->
<!--    <DocumentationFile>bin\Release\AutoSpectre.xml</DocumentationFile>-->
<!--  </PropertyGroup>-->
  <ItemGroup>
    <None Include="docs\Readme.md" Pack="true" PackagePath="\">
    </None>
    <None Include="images\ghost.png">
      <Pack>true</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <!-- Embed Roslyn-specific generator builds so each compiler loads the newest compatible variant. -->
  <ItemGroup>
    <None Include="..\AutoSpectre.SourceGeneration\bin\$(Configuration)\roslyn4.8\AutoSpectre.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs" Visible="false" />
    <None Include="..\AutoSpectre.SourceGeneration\bin\$(Configuration)\roslyn4.14\AutoSpectre.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.14/cs" Visible="false" />
    <None Include="..\AutoSpectre.SourceGeneration\bin\$(Configuration)\roslyn5.3\AutoSpectre.SourceGeneration.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
  </ItemGroup>

  <!-- Embed the analyzer and code fixes into this package -->
  <ItemGroup>
    <None Include="..\AutoSpectreAnalyzer\AutoSpectreAnalyzer\AutoSpectreAnalyzer\bin\$(Configuration)\netstandard2.0\AutoSpectreAnalyzer.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\AutoSpectreAnalyzer\AutoSpectreAnalyzer\AutoSpectreAnalyzer.CodeFixes\bin\$(Configuration)\netstandard2.0\AutoSpectreAnalyzer.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('..\AutoSpectreAnalyzer\AutoSpectreAnalyzer\AutoSpectreAnalyzer.CodeFixes\bin\$(Configuration)\netstandard2.0\AutoSpectreAnalyzer.CodeFixes.dll')" />
  </ItemGroup>

  <Target Name="BuildSourceGenerator" BeforeTargets="Build;Pack" Condition="'$(NoBuild)' != 'true' and '$(TargetFramework)' == 'net10.0'">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\AutoSpectre.SourceGeneration\AutoSpectre.SourceGeneration.csproj&quot; --configuration $(Configuration) --target Rebuild -p:AutoSpectreRoslynVersion=4.8.0 -p:OutputPath=bin\$(Configuration)\roslyn4.8\" />
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\AutoSpectre.SourceGeneration\AutoSpectre.SourceGeneration.csproj&quot; --configuration $(Configuration) --target Rebuild -p:AutoSpectreRoslynVersion=4.14.0 -p:OutputPath=bin\$(Configuration)\roslyn4.14\" />
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\AutoSpectre.SourceGeneration\AutoSpectre.SourceGeneration.csproj&quot; --configuration $(Configuration) --target Rebuild -p:AutoSpectreRoslynVersion=5.3.0 -p:OutputPath=bin\$(Configuration)\roslyn5.3\" />
  </Target>

  <Target Name="BuildAnalyzer" BeforeTargets="Build;Pack" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="..\AutoSpectreAnalyzer\AutoSpectreAnalyzer\AutoSpectreAnalyzer\AutoSpectreAnalyzer.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
  </Target>

</Project>